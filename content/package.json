{
  "name": "@inorganic/content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./runtime": "./src/runtime.ts",
    "./nomenclature-schema": "./src/nomenclature-schema.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "record-review": "node --import tsx src/record-review.ts",
    "release-check": "node --import tsx src/release-check.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "node --import tsx src/validate.ts",
    "generate:nomenclature": "node --import tsx src/generate-nomenclature.ts",
    "import:nomenclature": "node --import tsx src/import-nomenclature-seed.ts"
  },
  "dependencies": {
    "@inorganic/chemistry": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "4.23.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
