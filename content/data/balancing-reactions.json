          "title": "Určíme oxidační čísla a elektrony",
          "explanation": "Jod v IO3^- má oxidační číslo +V a redukuje se na 0. Jod v I^- má −I a oxiduje se na 0. Poměr elektronů je 1 : 5, proto použijeme 1 IO3^- a 5 I^-.",
          "focusedSpecies": ["IO3^-", "I^-"],
          "currentEquationLaTeX": "\\ce{IO3^- + 5 I^- + H^+ -> I2 + H2O}",
          "equation": {
            "reactants": [
              { "coefficient": 1, "formula": "IO3", "charge": -1 },
              { "coefficient": 5, "formula": "I", "charge": -1 },
              { "coefficient": 1, "formula": "H", "charge": 1 }
            ],
            "products": [
              { "coefficient": 1, "formula": "I2", "charge": 0 },
              { "coefficient": 1, "formula": "H2O", "charge": 0 }
            ]
          },
          "balanceLedger": {
            "atoms": [
              { "element": "I", "reactants": 6, "products": 2 },
              { "element": "O", "reactants": 3, "products": 1 },
              { "element": "H", "reactants": 1, "products": 2 }
            ],
            "charge": { "reactants": -5, "products": 0 },
            "redoxPairs": [
              { "species": "IO3^-", "fromOx": 5, "toOx": 0, "deltaE": 5 },
              { "species": "I^-", "fromOx": -1, "toOx": 0, "deltaE": -1 }
            ]
          },
          "ruleHighlight": "Při redoxním vyčíslování nejprve vyrovnejte přenesené elektrony."
        },
        {
          "stepIndex": 2,
          "title": "Vyrovnáme počet atomů jodu",
          "explanation": "Vlevo je celkem šest atomů jodu. Protože elementární jod je dvouatomová molekula I2, vzniknou tři molekuly I2.",
          "focusedSpecies": ["I2"],
          "currentEquationLaTeX": "\\ce{IO3^- + 5 I^- + H^+ -> 3 I2 + H2O}",
          "equation": {
            "reactants": [
              { "coefficient": 1, "formula": "IO3", "charge": -1 },
              { "coefficient": 5, "formula": "I", "charge": -1 },
              { "coefficient": 1, "formula": "H", "charge": 1 }
            ],
            "products": [
              { "coefficient": 3, "formula": "I2", "charge": 0 },
              { "coefficient": 1, "formula": "H2O", "charge": 0 }
