{
	email {$ACME_EMAIL}
	auto_https disable_redirects
}

{$DOMAIN} {
	tls {
		dns route53 {
			hosted_zone_id Z0249271YTBB81ZE9N1U
		}
	}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	@disabled_auth path /api/v1/auth/register /api/v1/auth/register/* /api/v1/auth/verification /api/v1/auth/verification/* /api/v1/auth/verify-email /api/v1/auth/verify-email/* /api/v1/auth/password-reset /api/v1/auth/password-reset/* /api/v1/auth/guest /api/v1/auth/guest/*

	# Keep private-deployment account actions blocked before requests reach the API.
	route {
		handle @disabled_auth {
			header Content-Type application/json
			respond `{"error":{"code":"private_deployment","message":"This account action is unavailable on this private deployment.","details":{}}}` 403
		}

		handle /api/* {
			request_body {
				max_size 1MB
			}
			header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
			reverse_proxy api:8000
		}

		handle {
			reverse_proxy web:3000
		}
	}
}

