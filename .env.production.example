# Replace all values before use. Keep this file outside source control.
DOMAIN=chemie.vvojtisek.eu
ACME_EMAIL=admin@vvojtisek.eu

POSTGRES_DB=inorganic_chemistry
POSTGRES_USER=inorganic_owner
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_SECRET
APP_DB_USER=inorganic_runtime
APP_DB_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_URL_SAFE_SECRET
MIGRATION_DATABASE_URL=postgresql+psycopg://inorganic_owner:REPLACE_WITH_RANDOM_URL_SAFE_SECRET@db:5432/inorganic_chemistry
DATABASE_URL=postgresql+psycopg://inorganic_runtime:REPLACE_WITH_ANOTHER_RANDOM_URL_SAFE_SECRET@db:5432/inorganic_chemistry

# Generate a fresh random value of at least 32 characters for the server.
SECRET_KEY=REPLACE_WITH_FRESH_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
PUBLIC_ORIGIN=https://chemie.vvojtisek.eu
CORS_ORIGINS=["https://chemie.vvojtisek.eu"]
FORWARDED_ALLOW_IPS=172.30.0.2
SESSION_IDLE_TTL=604800
SESSION_ABSOLUTE_TTL=2592000

# Use an SMTP relay that supports STARTTLS and a sender verified by that relay.
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_FROM=REPLACE_WITH_VERIFIED_SENDER@example.invalid
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_STARTTLS=true
SMTP_TIMEOUT=10

# GitHub repository whose latest Release is shown to administrators as an
# update notice. Leave empty to disable the hourly, read-only check.
RELEASE_CHECK_REPOSITORY=vvojtisek/chem-app

# Bearer token for Watchtower's update API, reachable only from the api
# container. Generate a fresh random value of at least 32 characters.
WATCHTOWER_HTTP_API_TOKEN=REPLACE_WITH_FRESH_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Admin console curriculum editing (ADR 0014). Leave all three empty to keep it
# off. The token is a fine-grained GitHub token limited to this repository with
# "Contents: read and write" and "Pull requests: read and write". It can push
# branches and open pull requests, so `main` must stay protected.
CURRICULUM_GITHUB_REPOSITORY=
CURRICULUM_GITHUB_TOKEN=
# Comma-separated <admin account UUID>=<reviewer ID from content/data/reviewers.json>
# pairs. Only these accounts can mark content as validated by a chemistry SME.
CURRICULUM_SME_REVIEWERS=

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
SEED_USER_USERNAME=user
SEED_USER_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
SEED_TESTER_USERNAME=tester
SEED_TESTER_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
