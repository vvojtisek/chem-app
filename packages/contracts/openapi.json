          },
          "totalAttempts": {
            "title": "Totalattempts",
            "type": "integer"
          }
        },
        "required": [
          "totalAttempts",
          "correctAttempts",
          "byMode"
        ],
        "title": "AttemptStats",
        "type": "object"
      },
      "BatchRequest": {
        "additionalProperties": false,
        "properties": {
          "events": {
            "items": {
              "discriminator": {
                "mapping": {
                  "element-name": "#/components/schemas/ElementNameAttempt",
                  "nomenclature": "#/components/schemas/NomenclatureAttempt",
                  "periodic-table": "#/components/schemas/PeriodicTableAttempt"
                },
                "propertyName": "mode"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ElementNameAttempt"
                },
                {
                  "$ref": "#/components/schemas/PeriodicTableAttempt"
                },
                {
                  "$ref": "#/components/schemas/NomenclatureAttempt"
                }
              ]
