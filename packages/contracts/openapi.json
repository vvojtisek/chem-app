            "title": "Direction",
            "type": "string"
          },
          "eventSchemaVersion": {
            "const": 1,
            "title": "Eventschemaversion",
            "type": "integer"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "isCorrect": {
            "title": "Iscorrect",
            "type": "boolean"
          },
          "match": {
            "enum": [
              "canonical",
              "alias",
              "missing-diacritics",
              "normalized",
              "none"
            ],
            "title": "Match",
            "type": "string"
          },
          "matchPolicy": {
            "enum": [
              "name-strict",
              "name-diacritics-tolerant",
              "name-lenient",
              "formula-canonical"
            ],
            "title": "Matchpolicy",
            "type": "string"
          },
          "mode": {
            "const": "nomenclature",
            "title": "Mode",
            "type": "string"
          },
          "occurredAt": {
            "format": "date-time",
            "title": "Occurredat",
            "type": "string"
          },
          "outcome": {
            "enum": [
              "correct",
              "incorrect",
              "revealed"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "questionId": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Questionid",
            "type": "string"
          },
          "round": {
            "enum": [
              "initial",
              "retry"
            ],
            "title": "Round",
            "type": "string"
          },
          "sequence": {
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Sequence",
            "type": "integer"
          },
          "sessionId": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Sessionid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "questionId",
          "contentVersion",
          "occurredAt",
          "isCorrect",
          "round",
          "mode",
          "eventSchemaVersion",
          "sessionId",
          "sequence",
          "compoundId",
          "outcome",
          "match",
          "direction",
          "matchPolicy"
        ],
        "title": "NomenclatureAttempt",
        "type": "object"
      },
      "PeriodicTableAttempt": {
        "additionalProperties": false,
        "properties": {
          "contentVersion": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Contentversion",
            "type": "string"
          },
          "direction": {
            "enum": [
              "name-to-position",
              "position-to-name",
              "position-to-name-or-symbol",
              "name-to-symbol",
              "symbol-to-name"
            ],
            "title": "Direction",
            "type": "string"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "isCorrect": {
            "title": "Iscorrect",
            "type": "boolean"
          },
          "matchPolicy": {
            "enum": [
              "exact-position",
              "diacritics-tolerant",
              "name-tolerant-or-symbol-exact",
              "symbol-exact"
            ],
            "title": "Matchpolicy",
            "type": "string"
          },
          "mode": {
            "const": "periodic-table",
            "title": "Mode",
            "type": "string"
          },
          "occurredAt": {
            "format": "date-time",
            "title": "Occurredat",
            "type": "string"
          },
          "questionId": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Questionid",
            "type": "string"
          },
          "round": {
            "enum": [
              "initial",
              "retry"
            ],
            "title": "Round",
            "type": "string"
          }
        },
        "required": [
          "id",
          "questionId",
          "contentVersion",
          "occurredAt",
          "isCorrect",
          "round",
          "mode",
          "direction",
          "matchPolicy"
        ],
        "title": "PeriodicTableAttempt",
        "type": "object"
      }
    },
    "securitySchemes": {
      "InorganicSessionCookie": {
        "description": "Opaque server-side browser session cookie.",
        "in": "cookie",
        "name": "__Host-inorganic_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Progress synchronization and server-owned state for the learning application.",
    "title": "Inorganic Chemistry Learning API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
