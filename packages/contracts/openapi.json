          },
          "duplicates": {
            "items": {
              "type": "string"
            },
            "title": "Duplicates",
            "type": "array"
          }
        },
        "required": [
          "accepted",
          "duplicates"
        ],
        "title": "BatchResponse",
        "type": "object"
      },
      "ElementNameAttempt": {
        "additionalProperties": false,
        "properties": {
          "contentVersion": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Contentversion",
            "type": "string"
          },
          "direction": {
            "const": "symbol-to-name",
            "title": "Direction",
            "type": "string"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "isCorrect": {
            "title": "Iscorrect",
            "type": "boolean"
          },
          "matchPolicy": {
            "const": "diacritics-tolerant",
            "title": "Matchpolicy",
            "type": "string"
          },
          "mode": {
            "const": "element-name",
            "title": "Mode",
            "type": "string"
          },
          "occurredAt": {
            "format": "date-time",
            "title": "Occurredat",
            "type": "string"
          },
          "questionId": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Questionid",
            "type": "string"
          },
          "round": {
            "enum": [
              "initial",
              "retry"
            ],
            "title": "Round",
            "type": "string"
          }
        },
        "required": [
          "id",
          "questionId",
          "contentVersion",
          "occurredAt",
          "isCorrect",
          "round",
          "mode",
          "direction",
          "matchPolicy"
        ],
        "title": "ElementNameAttempt",
        "type": "object"
      },
      "ErrorBody": {
