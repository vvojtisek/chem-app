APP_ENV=development
DATABASE_URL=postgresql+psycopg://app:local-development-only@localhost:5432/inorganic_chemistry
WEB_ORIGINS=["http://localhost:3000"]
# CORS_ORIGINS is also accepted and must equal PUBLIC_ORIGIN in production.
SECRET_KEY=local-development-only-secret-key-change-before-deployment
PUBLIC_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=__Host-inorganic_session
CSRF_COOKIE_NAME=__Host-inorganic_csrf
SESSION_COOKIE_SECURE=true
SESSION_IDLE_TTL=604800
SESSION_ABSOLUTE_TTL=2592000
# Pass this value to uvicorn --forwarded-allow-ips; only the Caddy IP belongs here.
FORWARDED_ALLOW_IPS=127.0.0.1
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_BEFORE_USE
SEED_USER_USERNAME=user
SEED_USER_PASSWORD=CHANGE_ME_BEFORE_USE
SEED_TESTER_USERNAME=tester
SEED_TESTER_PASSWORD=CHANGE_ME_BEFORE_USE
